# --- LLM provider: DeepSeek (OpenAI-compatible API) ---
# Leave empty to run in offline mock mode (deterministic, no network, no cost).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- Web search (optional) ---
# If set, Tavily is used; otherwise DuckDuckGo (pip install "agentflow[search]").
TAVILY_API_KEY=

# --- Tracing: Langfuse (optional, pip install "agentflow[tracing]") ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Runtime limits ---
AGENTFLOW_MAX_TOOL_CALLS=8
AGENTFLOW_MAX_REVISIONS=2
AGENTFLOW_RUNS_DIR=runs
# Force offline tools (no real web/HTTP) even when a key is set: 1/0
AGENTFLOW_OFFLINE=0
